# KIS Open API
KIS_APP_KEY=your-app-key
KIS_APP_SECRET=your-app-secret
KIS_ENV=prod

# KRX 데이터포털 (data.krx.co.kr) — ETF 전종목 기본정보(운용보수 등) 조회용, 이 수집기 전용 계정 권장
KRX_USERNAME=your-krx-id
KRX_PASSWORD=your-krx-password

# Supabase (secret key — 서버 전용, 절대 클라이언트에 노출 금지)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# APScheduler cron (기본: 평일 16:10 KST)
SYNC_CRON_DAY_OF_WEEK=mon-fri
SYNC_CRON_HOUR=16
SYNC_CRON_MINUTE=10