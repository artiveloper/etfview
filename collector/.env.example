# KIS Open API
KIS_APP_KEY=your-app-key
KIS_APP_SECRET=your-app-secret
KIS_ENV=prod

# Supabase (secret key — 서버 전용, 절대 클라이언트에 노출 금지)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# APScheduler cron (KST 기준, 기본값은 코드에 있음 — 아래는 예시)
# 장 시작 전 유니버스 동기화 (평일 08:30)
OPEN_CRON_DAY_OF_WEEK=mon-fri
OPEN_CRON_HOUR=8
OPEN_CRON_MINUTE=30
# 장중 일별 시세 갱신 (평일 09:00~15:30, 30분 간격)
INTRADAY_CRON_DAY_OF_WEEK=mon-fri
INTRADAY_CRON_HOUR=9-15
INTRADAY_CRON_MINUTE=0,30
# 장 마감 후 확정 동기화 (평일 15:40)
CLOSE_CRON_DAY_OF_WEEK=mon-fri
CLOSE_CRON_HOUR=15
CLOSE_CRON_MINUTE=40